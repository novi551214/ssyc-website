# ============================================
# SSYC Website - Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit your actual .env file to git.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# --- Database ---
# Local dev example: mongodb://127.0.0.1:27017/ssyc
# Production (MongoDB Atlas) example:
# mongodb+srv://<user>:<password>@cluster0.mongodb.net/ssyc?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ssyc

# --- Sessions / Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Admin login (seeded via `npm run seed:admin`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Stripe (TEST / sandbox keys) ---
# TODO: Insert your Stripe test secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TODO: Insert your Stripe test publishable key (used by the frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TODO: Insert the signing secret from your Stripe webhook endpoint (dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=
# TODO: Create these 3 recurring Prices in Stripe (test mode) and paste their IDs here
STRIPE_PRICE_FRIEND=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SUPPORTER=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PATRON=price_xxxxxxxxxxxxxxxxxx

# --- PayPal (sandbox) ---
# TODO: Insert your PayPal sandbox Client ID from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=sandbox_client_id_xxxxxxxxxxxxxxxxxxxxxxxx
# TODO: Insert your PayPal sandbox Client Secret
PAYPAL_CLIENT_SECRET=sandbox_client_secret_xxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_MODE=sandbox

# --- Mailchimp ---
# TODO: Insert your Mailchimp API key (Account > Extras > API keys)
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# The server suffix (e.g. "us21") is the part after the dash in your API key
MAILCHIMP_SERVER_PREFIX=us21
# TODO: Insert your Audience/List ID (Audience > Settings > Audience name and defaults)
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx

# --- Email (Nodemailer, for the Contact Us form) ---
# Example using Gmail with an App Password, or use SendGrid/Mailgun SMTP creds
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_NOTIFICATION_EMAIL=admin@ssyc.org
